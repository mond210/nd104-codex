<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Replace __NODE__ (absolute path to node) and __PROJECT_DIR__ (absolute path). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mond210.nd104-codex</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__PROJECT_DIR__/push-daemon.js</string>
    <string>--skip-unchanged</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PROJECT_DIR__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>ND_INTERVAL_MIN</key>
    <string>30</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>__PROJECT_DIR__/nd104.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_DIR__/nd104.log</string>
</dict>
</plist>